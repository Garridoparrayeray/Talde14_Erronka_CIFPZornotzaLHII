<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="bg-light" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PanelaController">
   <children>
      <HBox alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 15 30;" styleClass="bg-white">
         <children>
            <Label styleClass="font-title" text="Panela">
               <font><Font size="20.0" /></font>
            </Label>
         </children>
      </HBox>

      <VBox spacing="30.0" VBox.vgrow="ALWAYS">
         <children>

            <VBox spacing="5.0">
               <children>
                  <Label fx:id="lblEgunon" styleClass="font-title" text="Egun on..." />
                  <Label fx:id="lblData" styleClass="font-subtitle" text="..." />
               </children>
            </VBox>

            <HBox spacing="20.0">
               <children>
                  <VBox style="-fx-padding: 20;" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-label" text="BILTEGIAN" />
                        <Label fx:id="lblBiltegian" styleClass="kpi-value, text-primary" text="..." />
                     </children>
                  </VBox>
                  <VBox style="-fx-padding: 20;" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-label" text="ERREKLAMAZIO IREKIAK" />
                        <Label fx:id="lblErreklamazioIrekiak" styleClass="kpi-value, text-primary" text="..." />
                     </children>
                  </VBox>
                  <VBox style="-fx-padding: 20;" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-label" text="IRAUNGITZEAR (30 egun)" />
                        <Label fx:id="lblIraungitzear" styleClass="kpi-value, text-warning" text="..." />
                     </children>
                  </VBox>
                  <VBox style="-fx-padding: 20;" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="kpi-label" text="IRAUNGITUAK" />
                        <Label fx:id="lblIraungituak" styleClass="kpi-value, text-dark" text="..." />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="15.0" style="-fx-padding: 20;" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 16px;" styleClass="font-bold, text-dark" text="Azken mugimenduak" />
                        <TableView fx:id="tblMugimenduak" styleClass="table-view" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colArtikulua"   prefWidth="130.0" text="Artikulua" />
                              <TableColumn fx:id="colMugimenduId" prefWidth="200.0" text="Deskribapena" />
                              <TableColumn fx:id="colLangilea"    prefWidth="130.0" text="Langilea" />
                              <TableColumn fx:id="colData"        prefWidth="150.0" text="Data" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

                  <VBox prefWidth="300.0" spacing="15.0" style="-fx-padding: 20;" styleClass="card" HBox.hgrow="NEVER">
                     <children>
                        <Label style="-fx-font-size: 16px;" styleClass="font-bold, text-dark" text="Kategoriak" />
                        <TableView fx:id="tblKategoriak" styleClass="table-view" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colKategoria" prefWidth="160.0" text="Kategoria" />
                              <TableColumn fx:id="colKopurua"   prefWidth="80.0"  text="Kop." />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </children>
</VBox>
