<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="bg-light" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.IraungitakoakController">
   <children>

      <!-- Goiburua -->
      <HBox alignment="CENTER_LEFT" spacing="10.0"
            style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 12 20;"
            styleClass="bg-white">
         <children>
            <VBox>
               <children>
                  <Label styleClass="font-title" text="Iraungitako Artikuluak">
                     <font><Font size="20.0"/></font>
                  </Label>
                  <Label styleClass="text-muted" text="Bi urte igaro dira eta jabeak ez du aldarrikatu. Aurkitzaileari edo erakundeari eskaini." style="-fx-font-size: 12px;"/>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnEskaini" mnemonicParsing="false" styleClass="btn-outline"
                    text="Aurkitzaileari eskaini" onAction="#eskaintzaEgin"
                    style="-fx-padding: 6 14; -fx-font-size: 12px;" disable="true"/>
            <Button fx:id="btnErakundea" mnemonicParsing="false" styleClass="btn-primary"
                    text="Erakundeari eman" onAction="#erakundeaEskaini"
                    style="-fx-padding: 6 14; -fx-font-size: 12px;" disable="true"/>
         </children>
      </HBox>

      <VBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="taula" styleClass="table-view" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colKodea"    prefWidth="110.0" text="KODEA"/>
                        <TableColumn fx:id="colIzena"    prefWidth="160.0" text="IZENA"/>
                        <TableColumn fx:id="colIraungita" prefWidth="100.0" text="SARRERA"/>
                        <TableColumn fx:id="colAurkIzena" prefWidth="160.0" text="AURKITZAILEA"/>
                        <TableColumn fx:id="colAurkTel"  prefWidth="110.0" text="TELEFONOA"/>
                        <TableColumn fx:id="colAurkEmail" prefWidth="180.0" text="EMAILA"/>
                        <TableColumn fx:id="colEskainita" prefWidth="90.0"  text="EGOERA"/>
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
            </VBox>
         </children>
         <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>
      </VBox>

   </children>
</VBox>
