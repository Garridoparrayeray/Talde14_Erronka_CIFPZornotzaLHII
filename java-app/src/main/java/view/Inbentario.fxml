<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="bg-light" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.InbentarioController">
   <children>

      <!-- Goiburua + ekintza botoiak -->
      <HBox alignment="CENTER_LEFT" spacing="10.0"
            style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 12 20;"
            styleClass="bg-white">
         <children>
            <Label styleClass="font-title" text="Inbentarioa">
               <font><Font size="20.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <!-- Hautatutako artikuluarentzat -->
            <Button fx:id="btnIrudia"   mnemonicParsing="false" styleClass="btn-outline"
                    text="Argazkia" onAction="#ikusiIrudia"
                    style="-fx-padding: 6 12; -fx-font-size: 12px;" disable="true" />
            <Button fx:id="btnEditatu"  mnemonicParsing="false" styleClass="btn-outline"
                    text="✏ Editatu" onAction="#editatu"
                    style="-fx-padding: 6 12; -fx-font-size: 12px;" disable="true" />
            <Button fx:id="btnEzabatu"  mnemonicParsing="false"
                    style="-fx-padding: 6 12; -fx-font-size: 12px; -fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-background-radius: 6;"
                    text="Ezabatu" onAction="#ezabatu" disable="true" />
            <!-- Beti aktibo -->
            <Button mnemonicParsing="false" styleClass="btn-primary"
                    text="⬇ XML" onAction="#exportatuXML"
                    style="-fx-padding: 6 14; -fx-font-size: 12px;" />
         </children>
      </HBox>

      <VBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Bilaketa filtroak -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtBilaketa" prefWidth="300.0"
                                   promptText="Bilatu ID, izena edo deskribapena..."
                                   styleClass="form-control" HBox.hgrow="ALWAYS"
                                   onAction="#bilatu" />
                        <ComboBox fx:id="cbKategoria" prefWidth="170.0"
                                  promptText="Kategoria guztiak"
                                  styleClass="form-select" onAction="#bilatu" />
                        <ComboBox fx:id="cbEgoera" prefWidth="140.0"
                                  promptText="Egoera guztiak"
                                  styleClass="form-select" onAction="#bilatu" />
                        <Button mnemonicParsing="false" styleClass="btn-outline"
                                text="Garbitu" onAction="#garbitu" />
                     </children>
                  </HBox>

                  <!-- Taula -->
                  <TableView fx:id="taula" styleClass="table-view" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colKodea"        prefWidth="110.0" text="ID" />
                        <TableColumn fx:id="colIzena"        prefWidth="170.0" text="IZENA" />
                        <TableColumn fx:id="colDeskribapena" prefWidth="210.0" text="DESKRIBAPENA" />
                        <TableColumn fx:id="colKategoria"    prefWidth="140.0" text="KATEGORIA" />
                        <TableColumn fx:id="colKokalekua"    prefWidth="100.0" text="KOKALEKUA" />
                        <TableColumn fx:id="colSarrera"      prefWidth="100.0" text="SARRERA" />
                        <TableColumn fx:id="colEgoera"       prefWidth="110.0" text="EGOERA" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </VBox>
   </children>
</VBox>
