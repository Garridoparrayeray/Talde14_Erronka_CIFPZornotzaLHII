<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="contentArea" styleClass="bg-light" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InbentarioController">
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>

            <!-- Goiburua -->
            <HBox alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 15 30;" styleClass="bg-white">
               <children>
                  <Label styleClass="font-title" text="Inbentarioa">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnIrudia" disable="true" mnemonicParsing="false" onAction="#ikusiIrudia" styleClass="btn-outline" text="Argazkia" minWidth="90" />
                  <Button fx:id="btnEditatu" disable="true" mnemonicParsing="false" onAction="#editatu" styleClass="btn-outline" text="Editatu" minWidth="80" />
                  <Button fx:id="btnEzabatu" disable="true" mnemonicParsing="false" onAction="#ezabatu" style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-border-color: #FEE2E2;" styleClass="btn-outline" text="Ezabatu" minWidth="80" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#inportatuXML" style="-fx-padding: 6 14; -fx-font-size: 12px;" styleClass="btn-outline" text="⬆ XML Inportatu" minWidth="130" />
                  <HBox prefWidth="10.0" />
                  <Button mnemonicParsing="false" onAction="#exportatuXML" style="-fx-padding: 6 14; -fx-font-size: 12px;" styleClass="btn-primary" text="⬇ XML Exportatu" minWidth="130" />
               </children>
            </HBox>

            <VBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="20.0" styleClass="card" VBox.vgrow="ALWAYS">
                     <children>

                        <!-- Ekintza botoiak eta Bilaketa filtroak -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <TextField fx:id="txtBilaketa" onAction="#bilatu" prefWidth="300.0" promptText="Bilatu ID, izena edo deskribapena..." styleClass="form-control" HBox.hgrow="ALWAYS" />
                              <Region prefHeight="44.0" prefWidth="150.0" />
                              <ComboBox fx:id="cbKategoria" onAction="#bilatu" prefWidth="170.0" promptText="Kategoria" styleClass="form-select" />
                              <ComboBox fx:id="cbEgoera" onAction="#bilatu" prefWidth="140.0" promptText="Egoera" styleClass="form-select" />
                              <Button mnemonicParsing="false" onAction="#garbitu" styleClass="btn-outline" text="Garbitu" />
                           </children>
                        </HBox>

                        <!-- Taula -->
                        <TableView fx:id="taula" styleClass="table-view" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colKodea" prefWidth="110.0" text="ID" />
                              <TableColumn fx:id="colIzena" prefWidth="170.0" text="IZENA" />
                              <TableColumn fx:id="colDeskribapena" prefWidth="210.0" text="DESKRIBAPENA" />
                              <TableColumn fx:id="colKategoria" prefWidth="140.0" text="KATEGORIA" />
                              <TableColumn fx:id="colKokalekua" prefWidth="100.0" text="KOKALEKUA" />
                              <TableColumn fx:id="colSarrera" prefWidth="100.0" text="SARRERA" />
                              <TableColumn fx:id="colEgoera" prefWidth="110.0" text="EGOERA" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                     </children>
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>
