<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="600.0" prefHeight="520.0" spacing="15.0" styleClass="bg-light"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.IrudiaPopupController">
   <children>

      <!-- Goiburua -->
      <HBox alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 12 20;" styleClass="bg-white">
         <children>
            <Label fx:id="lblKodea" styleClass="font-bold, text-dark">
               <font><Font size="15.0" /></font>
            </Label>
         </children>
      </HBox>

      <!-- Irudia -->
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #F3F4F6; -fx-border-color: transparent;"
                  prefHeight="360.0">
         <content>
            <VBox alignment="CENTER" style="-fx-min-height: 300px;">
               <children>
                  <ImageView fx:id="imgArgazkia" fitWidth="560.0" preserveRatio="true"
                             smooth="true" />
                  <Label fx:id="lblNoImage" styleClass="text-muted" text="Argazkirik ez dago"
                         style="-fx-font-size: 14px;" managed="false" visible="false" />
               </children>
               <padding><Insets top="10.0" bottom="10.0" /></padding>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Deskribapena -->
      <VBox spacing="6.0" styleClass="card">
         <children>
            <Label styleClass="font-bold, text-dark" text="Deskribapena" />
            <Label fx:id="lblDeskribapena" styleClass="text-muted" wrapText="true" />
         </children>
         <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
      </VBox>

      <!-- Botoia -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button mnemonicParsing="false" styleClass="btn-primary" text="Itxi" onAction="#itxi"
                    style="-fx-padding: 8 24;" />
         </children>
         <padding><Insets bottom="15.0" right="15.0" /></padding>
      </HBox>

   </children>
</VBox>
