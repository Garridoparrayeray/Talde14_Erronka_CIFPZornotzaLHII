<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="bg-light" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EmanaldiaController">
   <children>

      <HBox alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 15 30;" styleClass="bg-white">
         <children>
            <Label styleClass="font-title" text="Emanaldia">
               <font><Font size="20.0" /></font>
            </Label>
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-border-color: transparent;">
         <content>
            <VBox spacing="20.0">
               <children>

                  <HBox spacing="20.0">
                     <children>

                        <!-- Artikuluaren txartela -->
                        <VBox prefWidth="380.0" spacing="15.0" styleClass="card" HBox.hgrow="NEVER">
                           <children>
                              <Label style="-fx-font-size: 16px;" styleClass="font-bold, text-dark" text="Artikulua" />

                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="text-muted" text="Artikulua hautatu *" />
                                    <ComboBox fx:id="cbArtikulua" maxWidth="1.7976931348623157E308"
                                              promptText="— Hautatu biltegiko artikulu bat —"
                                              styleClass="form-select"
                                              onAction="#artikuluaHautatu" />
                                 </children>
                              </VBox>

                              <VBox spacing="6.0">
                                 <children>
                                    <Label fx:id="lblArtikuluKodea"    styleClass="text-muted"    managed="false" visible="false" />
                                    <Label fx:id="lblArtikuluIzena"    styleClass="font-bold, text-dark" managed="false" visible="false" />
                                    <Label fx:id="lblArtikuluKokalekua" styleClass="text-muted"   managed="false" visible="false" />
                                    <Label fx:id="lblArtikuluSarrera"  styleClass="text-muted"    managed="false" visible="false" />
                                    <Label fx:id="lblArtikuluEgoera"   styleClass="badge-primary" managed="false" visible="false" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>

                        <!-- Hartzailearen datuak -->
                        <VBox spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 16px;" styleClass="font-bold, text-dark" text="Hartzailearen datuak" />

                              <!-- Toggle: Pertsona / Erakundea -->
                              <HBox spacing="15.0" alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="font-bold, text-dark" text="Mota:" />
                                    <RadioButton fx:id="rbPertsona" mnemonicParsing="false" text="Pertsona (NAN)" selected="true" onAction="#aldatuHartzaileMota">
                                       <toggleGroup><ToggleGroup fx:id="tgHartzailea" /></toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="rbErakundea" mnemonicParsing="false" text="Erakundea (IFZ)" toggleGroup="$tgHartzailea" onAction="#aldatuHartzaileMota" />
                                 </children>
                              </HBox>

                              <!-- Pertsona eremuak -->
                              <VBox fx:id="boxPertsona" spacing="10.0">
                                 <children>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="text-muted" text="NAN/Dokumentua *" />
                                          <TextField fx:id="txtNan" promptText="12345678X" styleClass="form-control" />
                                       </children>
                                    </VBox>
                                    <GridPane hgap="15.0" vgap="10.0">
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                          <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                       </columnConstraints>
                                       <children>
                                          <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                             <children>
                                                <Label styleClass="text-muted" text="Izena *" />
                                                <TextField fx:id="txtIzena" promptText="Iker" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                             <children>
                                                <Label styleClass="text-muted" text="Abizena *" />
                                                <TextField fx:id="txtAbizena" promptText="Mendia" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </GridPane>
                                 </children>
                              </VBox>

                              <!-- Erakundea eremuak -->
                              <VBox fx:id="boxErakundea" spacing="10.0" managed="false" visible="false">
                                 <children>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="text-muted" text="IFZ (Identifikazio Fiskaleko Zenbakia) *" />
                                          <TextField fx:id="txtIft" promptText="B48123456" styleClass="form-control" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="text-muted" text="Izen ofiziala *" />
                                          <TextField fx:id="txtIzenOfiziala" promptText="Bermeo SL" styleClass="form-control" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>

                              <!-- Kontaktua (biek partekatzen dute) -->
                              <GridPane hgap="15.0" vgap="10.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                 </columnConstraints>
                                 <children>
                                    <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                       <children>
                                          <Label styleClass="text-muted" text="Telefonoa" />
                                          <TextField fx:id="txtTelefonoa" promptText="666 12 34 56" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                       <children>
                                          <Label styleClass="text-muted" text="E-posta" />
                                          <TextField fx:id="txtEmaila" promptText="i.mendia@mail.eus" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                                       </children>
                                    </VBox>
                                 </children>
                              </GridPane>

                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="text-muted" text="Helbidea" />
                                    <TextField fx:id="txtHelbidea" promptText="Lamera kalea 12, 1.A" styleClass="form-control" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>

                     </children>
                  </HBox>

                  <!-- Oharrak eta sinadura -->
                  <VBox spacing="15.0" styleClass="card">
                     <children>
                        <Label style="-fx-font-size: 16px;" styleClass="font-bold, text-dark" text="Oharrak eta berrespena" />

                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="text-muted" text="Oharrak" />
                              <TextArea fx:id="txtOharrak" prefHeight="80.0" wrapText="true"
                                        promptText="Ohar gehigarriak (aukerazkoa)..."
                                        styleClass="form-control" />
                           </children>
                        </VBox>

                        <HBox spacing="30.0">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="font-bold, text-dark" text="Legezko oharra:" />
                                    <Label styleClass="text-muted" wrapText="true"
                                           text="Artikulua hartzaileari emanez, honek aitortzen du bere jabegokoa dela. Udalak dokumentu sinatua 5 urtez gordeko du." />
                                 </children>
                                 <HBox.hgrow>ALWAYS</HBox.hgrow>
                              </VBox>
                              <VBox spacing="10.0" alignment="CENTER_LEFT">
                                 <children>
                                    <CheckBox fx:id="chkNortasuna" mnemonicParsing="false"
                                              styleClass="check-box"
                                              text="Hartzaileak bere nortasuna egiaztatu du" />
                                    <CheckBox fx:id="chkSinadura" mnemonicParsing="false"
                                              styleClass="check-box"
                                              text="Sinadurazko agiria jaso da" />
                                    <VBox spacing="5.0" style="-fx-padding: 4 0 0 0;">
                                       <children>
                                          <Label styleClass="text-muted" text="Sinadura dokumentua (PDF/JPG/PNG)" style="-fx-font-size: 11px;" />
                                          <HBox spacing="8.0" alignment="CENTER_LEFT">
                                             <children>
                                                <Button mnemonicParsing="false" styleClass="btn-outline"
                                                        text="Aukeratu fitxategia..."
                                                        onAction="#hautaketaSinadura"
                                                        style="-fx-padding: 4 12; -fx-font-size: 11px;" />
                                                <Label fx:id="lblArchivoSinadura" styleClass="text-muted"
                                                       text="Ez da fitxategirik hautatu."
                                                       style="-fx-font-size: 11px;" wrapText="true" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Label fx:id="lblErrorea" styleClass="text-danger" wrapText="true" managed="false" visible="false" />

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                           <children>
                              <Button mnemonicParsing="false" styleClass="btn-outline"
                                      text="Utzi" onAction="#utzi" />
                              <Button mnemonicParsing="false" styleClass="btn-primary"
                                      text="Emanaldia formalizatu" onAction="#formalizatu" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>

               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
