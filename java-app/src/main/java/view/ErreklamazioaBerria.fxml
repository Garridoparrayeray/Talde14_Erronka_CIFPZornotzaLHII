<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ErreklamazioaBerriController"
      style="-fx-background-color: white;">

   <children>

      <!-- Cabecera fija -->
      <VBox style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 20 25 15 25;">
         <children>
            <Label text="Erreklamazino berria" styleClass="font-bold, text-dark">
               <font><Font size="18.0" /></font>
            </Label>
            <Label text="Betete eremuak galdu duen pertsonaren erreklamazioa sortzeko." styleClass="text-muted">
               <font><Font size="12.0" /></font>
            </Label>
         </children>
      </VBox>

      <!-- Formularioa ScrollPane barruan -->
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-border-color: transparent;">
         <content>
            <VBox spacing="15.0" style="-fx-padding: 20 25; -fx-background-color: white;">
               <children>

                  <Label text="PERTSONA DATUAK" styleClass="text-muted, font-bold">
                     <font><Font size="11.0" /></font>
                  </Label>

                  <GridPane hgap="15.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <children>
                              <Label text="Izena *" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                              <TextField fx:id="txtIzena" promptText="Izena" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label text="Abizena *" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                              <TextField fx:id="txtAbizena" promptText="Abizena" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <children>
                              <Label text="NAN *" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                              <TextField fx:id="txtNan" promptText="12345678A" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label text="Telefonoa" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                              <TextField fx:id="txtTelefonoa" promptText="666 123 456" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                           <children>
                              <Label text="E-maila" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                              <TextField fx:id="txtEmaila" promptText="pertsona@mail.eus" styleClass="form-control" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <Label text="ERREKLAMAZIOAREN XEHETASUNAK" styleClass="text-muted, font-bold" style="-fx-padding: 5 0 0 0;">
                     <font><Font size="11.0" /></font>
                  </Label>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="Kategoria *" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                        <ComboBox fx:id="cbKategoria" promptText="Hautatu kategoria..." maxWidth="1.7976931348623157E308" styleClass="form-select" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="Galdu denaren deskribapena *" styleClass="text-muted"><font><Font size="11.0" /></font></Label>
                        <TextArea fx:id="txtDeskribapena"
                                  promptText="Deskribatu galdu den objektua: kolorea, markak, ezaugarri bereziak..."
                                  styleClass="form-control" prefHeight="90.0" wrapText="true" />
                     </children>
                  </VBox>

                  <Label fx:id="lblErrorea" styleClass="text-danger" wrapText="true" managed="false" visible="false">
                     <font><Font size="11.0" /></font>
                  </Label>

               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Botoiak beti behean -->
      <HBox spacing="10.0" alignment="CENTER_RIGHT"
            style="-fx-border-color: #E5E7EB transparent transparent transparent; -fx-padding: 12 25; -fx-background-color: white;">
         <children>
            <Button fx:id="btnUtzi" text="Utzi" mnemonicParsing="false" styleClass="btn-outline"
                    onAction="#utzi" />
            <Button fx:id="btnGorde" text="Gorde" mnemonicParsing="false" styleClass="btn-primary"
                    onAction="#gorde" />
         </children>
      </HBox>

   </children>
</VBox>
