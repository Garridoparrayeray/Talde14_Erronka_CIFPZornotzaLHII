<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="bg-light" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.GalduDabenakController">

   <children>

      <!-- Cabecera -->
      <HBox alignment="CENTER_LEFT" spacing="10"
            style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 15 30;"
            styleClass="bg-white">
         <children>
            <Label styleClass="font-title" text="Galdu dabenak">
               <font><Font size="20.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Freskatu" mnemonicParsing="false"
                    styleClass="btn-outline" onAction="#freskatu" />
         </children>
      </HBox>

      <!-- Barra de filtros -->
      <HBox alignment="CENTER_LEFT" spacing="12"
            style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 10 30;"
            styleClass="bg-white">
         <children>
            <CheckBox fx:id="cbBaztertuak" text="Baztertuak erakutsi"
                      onAction="#aldatuBaztertuak" />
            <CheckBox fx:id="cbEgindak" text="Egindak erakutsi"
                      onAction="#aldatuEgindak" />
            <!-- Date filter - hidden until checkbox checked -->
            <HBox fx:id="hboxDateFilter" alignment="CENTER_LEFT" spacing="8">
               <children>
                  <Label text="Nondik:" styleClass="text-muted">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <DatePicker fx:id="dpHasiera" promptText="Hasiera data"
                              prefWidth="140" onAction="#iragaziDataBidez" />
                  <Label text="Nora:" styleClass="text-muted">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <DatePicker fx:id="dpAmaiera" promptText="Amaiera data"
                              prefWidth="140" onAction="#iragaziDataBidez" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <!-- Taula ScrollPane barruan -->
      <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                  style="-fx-padding: 20;">
         <content>
            <VBox styleClass="card" style="-fx-min-width: 900;">
               <children>
                  <TableView fx:id="taula"
                             VBox.vgrow="ALWAYS"
                             style="-fx-pref-height: 600;">
                     <columns>
                        <TableColumn fx:id="colZbk"          text="Zbk"          prefWidth="55"  />
                        <TableColumn fx:id="colData"          text="Data"         prefWidth="100" />
                        <TableColumn fx:id="colIzena"         text="Izena"        prefWidth="100" />
                        <TableColumn fx:id="colAbizena"       text="Abizena"      prefWidth="120" />
                        <TableColumn fx:id="colTelefonoa"     text="Telefonoa"    prefWidth="115" />
                        <TableColumn fx:id="colEmaila"        text="E-maila"      prefWidth="190" />
                        <TableColumn fx:id="colKategoria"     text="Kategoria"    prefWidth="160" />
                        <TableColumn fx:id="colDeskribapena"  text="Deskribapena" prefWidth="250" />
                        <TableColumn fx:id="colEgoera"        text="Egoera"       prefWidth="100" />
                     </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>

   </children>
</VBox>
