<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="520.0" spacing="18.0" styleClass="bg-light"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ArtikuluaEdituController">
   <children>

      <!-- Goiburua -->
      <HBox alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 12 20;" styleClass="bg-white">
         <children>
            <Label fx:id="lblTitulua" styleClass="font-bold, text-dark">
               <font><Font size="16.0" /></font>
            </Label>
         </children>
      </HBox>

      <!-- Formularioa -->
      <VBox spacing="14.0" styleClass="card">
         <children>

            <VBox spacing="6.0">
               <children>
                  <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Izena *" />
                  <TextField fx:id="txtIzena" styleClass="form-control" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Kategoria" />
                  <ComboBox fx:id="cbKategoria" maxWidth="1.7976931348623157E308" styleClass="form-select" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Kokalekua" />
                  <ComboBox fx:id="cbKokalekua" maxWidth="1.7976931348623157E308" styleClass="form-select" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Deskribapena" />
                  <TextArea fx:id="txtDeskribapena" prefHeight="100.0" wrapText="true" styleClass="text-area" />
               </children>
            </VBox>

            <!-- Argazkia -->
            <VBox spacing="6.0">
               <children>
                  <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Argazkia" />
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblArgazkiIzena" styleClass="text-muted"
                               text="Ez da irudirik hautatu." wrapText="true" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" styleClass="btn-outline"
                                text="Aldatu..." onAction="#hautatuArgazkia"
                                style="-fx-padding: 5 12; -fx-font-size: 11px;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <Label fx:id="lblErrorea" styleClass="text-danger" wrapText="true" managed="false" visible="false" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" styleClass="btn-outline" text="Utzi" onAction="#itxi" />
                  <Button mnemonicParsing="false" styleClass="btn-primary" text="Gorde" onAction="#gorde" />
               </children>
            </HBox>

         </children>
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
      </VBox>

   </children>
</VBox>
