<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="contentArea" styleClass="bg-light" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ErreklamazioakController">
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>

            <!-- Cabecera -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-padding: 15 30;"
                  styleClass="bg-white">
               <children>
                  <Label styleClass="font-title" text="Erreklamazioak">
                     <font><Font size="20.0" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnFiltroIrekiak"   text="Irekiak"     mnemonicParsing="false" styleClass="btn-primary" onAction="#filtroIrekiak" />
                  <Button fx:id="btnFiltroBaztertuak" text="Baztertutak" mnemonicParsing="false" styleClass="btn-outline" onAction="#filtroBaztertutak" />
                  <Button fx:id="btnFiltroEgindak"   text="Egindak"     mnemonicParsing="false" styleClass="btn-outline" onAction="#filtroEgindak" />
                  <Button text="+ Berria" mnemonicParsing="false"
                          styleClass="btn-primary" onAction="#erreklamazioaBerria" />
               </children>
            </HBox>

            <!-- Edukia -->
            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                        style="-fx-padding: 20; -fx-background-color: transparent;">
               <content>
                  <HBox spacing="20.0" style="-fx-min-width: 720;">
                     <children>

                        <!-- Ezkerreko zerrenda -->
                        <ScrollPane fitToHeight="true" fitToWidth="true"
                                    style="-fx-pref-width: 280; -fx-min-width: 260; -fx-max-width: 300;">
                           <content>
                              <VBox styleClass="list-group" style="-fx-min-width: 240;">
                                 <children>
                                    <HBox style="-fx-padding: 15; -fx-border-color: transparent transparent #E5E7EB transparent;">
                                       <children>
                                          <Label styleClass="font-bold, text-dark" text="Erreklamazioak · " />
                                          <Label fx:id="lblKopurua" styleClass="text-muted" text="0" />
                                       </children>
                                    </HBox>
                                    <VBox fx:id="listVBox" />
                                 </children>
                              </VBox>
                           </content>
                        </ScrollPane>

                        <!-- Eskuineko xehetasun panela -->
                        <VBox fx:id="panelXehetasuna" spacing="20.0" styleClass="card"
                              HBox.hgrow="ALWAYS" maxHeight="1.7976931348623157E308">
                           <children>

                              <!-- Identifikazioa + egoera -->
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label fx:id="lblIdErreklam" style="-fx-font-size: 12px;" styleClass="text-muted" text="—" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblEgoeraBadge" styleClass="badge-neutral" text="—" />
                                 </children>
                              </HBox>

                              <!-- Izena eta kontaktua -->
                              <VBox spacing="3.0">
                                 <children>
                                    <Label fx:id="lblJabeIzena" style="-fx-font-size: 22px;" styleClass="font-bold, text-dark" text="—" />
                                    <Label fx:id="lblKontaktua" styleClass="text-muted" text="—" />
                                 </children>
                              </VBox>

                              <!-- Deskribapena -->
                              <VBox styleClass="box-muted">
                                 <children>
                                    <Label style="-fx-text-fill: #374151;" styleClass="font-bold" text="Erreklamazioaren deskribapena:">
                                       <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                                    </Label>
                                    <Label fx:id="lblDeskribapenaTestua" styleClass="text-muted" wrapText="true" text="—" />
                                 </children>
                              </VBox>

                              <!-- Egoera aldatu botoiak -->
                              <HBox spacing="10.0">
                                 <children>
                                    <Button fx:id="btnEbatzi" text="Ebatzi" mnemonicParsing="false"
                                            styleClass="btn-primary" onAction="#ebatzi" />
                                    <Button fx:id="btnBaztertu" text="Baztertu" mnemonicParsing="false"
                                            styleClass="btn-outline" onAction="#baztertu" />
                                    <Button fx:id="btnIrekiBerriz" text="Berriro ireki" mnemonicParsing="false"
                                            styleClass="btn-outline" onAction="#irekiBerriz"
                                            visible="false" managed="false" />
                                 </children>
                              </HBox>

                              <!-- Bat-etortze posibleak (scroll) -->
                              <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
                                 <content>
                                    <VBox spacing="8.0">
                                       <children>
                                          <Label style="-fx-font-size: 14px;" styleClass="font-bold, text-dark"
                                                 text="Bat-etortze posibleak">
                                             <VBox.margin><Insets bottom="2.0" /></VBox.margin>
                                          </Label>
                                          <VBox fx:id="vboxBateragarriak" spacing="6.0" />
                                       </children>
                                    </VBox>
                                 </content>
                              </ScrollPane>

                           </children>
                           <padding>
                              <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                           </padding>
                        </VBox>

                     </children>
                  </HBox>
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </children>
</StackPane>
